      "profileName": "Underwriting",
      "trustServerCertificate": true,
      "savePassword": true,
      "groupId": "ROOT",
      "id": "3A631692-6491-44DF-A8FE-C248A8870651",
      "profileSource": 0,
    },
  ],
  "@azure.argTenant": "582259a1-dcaa-4cca-b1cf-e60d3f045ecd",
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"],
    },
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "d"],
      "after": ["d", "d"],
    },
    {
      "before": ["<leader>", "f", "f"],
      "command": ["workbench.action.findInFiles"],
    },
    {
      "key": "escape",
      "command": "workbench.action.closePanel",
      "when": "panelFocus",
    },
    {
      "before": ["<C-n>"],
      "commands": [":nohl"],
    },
    {
      "before": ["<C-h>"],
      "after": ["<C-w>", "h"],
    },
    {
      "before": ["<C-j>"],
      "after": ["<C-w>", "j"],
    },
    {
      "before": ["<C-k>"],
      "after": ["<C-w>", "k"],
    },
    {
      "before": ["<C-l>"],
      "after": ["<C-w>", "l"],
    },
    {
      "before": ["<Leader>", "e"],
      "commands": ["workbench.files.action.showActiveFileInExplorer"],
    },
    {
      "before": ["<Leader>", "w", "e"],
      "commands": ["workbench.action.toggleSidebarVisibility"],
    },
    {
      "before": ["<Leader>", "w", "m"],
      "commands": ["workbench.action.toggleActivityBarVisibility"],
    },
    {
      "before": ["<Leader>", "s", "s"],
      "commands": [":vs"],
    },
    {
      "before": ["<Leader>", "s", "h"],
      "commands": [":sp"],
    },
    {
      "before": ["<Leader>", "t", "t"],
      "commands": [":tabnew"],
    },
    {
      "before": ["S-l"],
      "commands": [":tabnext"],
    },
    {
      "before": ["S-h"],
      "commands": [":tabprev"],
    },
    {
      "before": ["<Leader>", "t", "o"],
      "commands": [":tabo"],
    },
    {
      "before": ["leader", "w"],
      "commands": ["workbench.action.files.save"],
    },
    {
      "before": ["<Leader>", "t"],
      "commands": ["workbench.action.gotoSymbol"],
    },
    {
      "before": ["g", "h"],
      "commands": ["editor.action.showHover"],
    },
    {
      "before": ["S-K"],
      "commands": ["editor.action.showHover"],
    },
    {
      "before": ["g", "r"],
      "commands": ["editor.action.goToReferences"],
    },
    {
      "before": ["g", "i"],
      "commands": ["editor.action.goToImplementation"],
    },
  ],
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-p>": false,
    "<C-a>": true,
    "<C-f>": false,
  },
  "chat.agent.maxRequests": 100,
  "remote.autoForwardPortsSource": "hybrid",
  "chat.viewSessions.orientation": "stacked",
}
