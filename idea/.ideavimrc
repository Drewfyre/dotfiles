" .ideavimrc is a configuration file for IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" You can find a list of commands here: https://jb.gg/h38q75
" Find more examples here: https://jb.gg/share-ideavimrc
let mapleader = " "

set relativenumber
set number relativenumber
set smartcase
set noshowmatch
set hidden
set noerrorbells
set visualbell
set linebreak
set mouse=a
set commentary
set surround
set ideajoin
set multiple-cursors
set highlightedyank
set quickscope
set scrolloff=5
set clipboard=unnamedplus
set ignorecase
set incsearch
set hlsearch

set tabstop=4 softtabstop=4
set shiftwidth=4
set expandtab

set noswapfile
set nobackup
set undodir=~/.vim/undodir
set undofile

filetype plugin indent on
syntax on

set updatetime=500

autocmd VimEnter * hi Normal ctermbg=NONE guibg=NONE

" Highlight copied text
Plug 'machakann/vim-highlightedyank'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-surround'
Plug 'junegunn/fzf.vim'

" Copy to clipboard
vnoremap  <leader>y  "+y
nnoremap  <leader>Y  "+yg_
nnoremap  <leader>y  "+y

" Paste from clipboard
nnoremap <leader>p "+p
nnoremap <leader>P "+P
vnoremap <leader>p "+p
vnoremap <leader>P "+P

" window navigation
nnoremap <C-J> <C-W><C-J>
nnoremap <C-K> <C-W><C-K>
nnoremap <C-L> <C-W><C-L>
nnoremap <C-H> <C-W><C-H>
map <S-h> <Action>(PreviousTab)
map <S-l> <Action>(NextTab)

map <leader>ss <Action>(SplitVertically)
map <leader>sv <Action>(SplitHorizontally)

map <Esc><Esc> :noh<CR>

map <leader>. <Action>(Refactoring.QuickListPopupAction)
nmap , <Action>(ShowIntentionActions)
map <leader>e <Action>(ReSharperGotoNextErrorInSolution)
map <leader>r <Action>(RenameElement)
map <leader><leader> <Action>(SearchEverywhere)
map <leader>d <Action>(Debug)
map <leader>b <Action>(ToggleLineBreakpoint)
map <leader>B <Action>(ViewBreakpoints)
map <leader>bt <Action>(XDebugger.MuteBreakpoints)
map <leader>w <Action>(SaveAll)

map <leader>ta <Action>(Rider.UnitTesting.RunSolution)
map <leader>tt <Action>(RiderUnitTestRunContextAction)
map <leader>td <Action>(RiderUnitTestDebugContextAction)
map <leader>ts <Action>(RiderUnitTestNewSessionAction)
map <leader>tf <Action>(RiderUnitTestSessionRerunFailedTestsAction)
map <leader>tc <Action>(RiderUnitTestRunCurrentSessionAction)

map gi <Action>(GotoImplementation)
map gd <Action>(GotoDeclaration)
map gr <Action>(ShowUsages)
map gh <Action>(QuickJavaDoc)
map gt <Action>(GotoTypeDeclaration)

map <leader>s <Action>(FileStructurePopup)

nmap <Tab> <Action>(ShowErrorDescription)
nmap <Space> <C-D>
nmap <S-Space> <C-U>
nmap gcc <Action>(CommentByLineComment)
vmap gcc <Action>(CommentByLineComment)

map <leader>wt <Action>(ActivateUnitTestsToolWindow)
map <leader>wd <Action>(ActivateDebugToolWindow)
map <leader>wp <Action>(ActivateProjectToolWindow)
map <leader>we <Action>(Rider.ProblemsView.ErrorsInSolution)
map <leader>ww <Action>(HideAllWindows)

map <leader>rv <Action>(IntroduceVariable)
map <leader>rf <Action>(IntroduceField)
map <leader>rp <Action>(IntroduceParameter)
map <leader>rc <Action>(IntroduceConstant)
map <leader>rm <Action>(ExtractMethod)

nmap <C-o> <Action>(Back)
nmap <C-i> <Action>(Forward)

imap <PageUp> <Space>
imap <PageDown> <Space>

vmap <leader>hh <Action>(Vcs.ShowHistoryForBlock)
nmap <leader>hh <Action>(Vcs.ShowHistoryForBlock)

" https://youtrack.jetbrains.com/issue/VIM-2178/multiple-cursors-defines-incorrect-keys
" Remap multiple-cursors shortcuts to match terryma/vim-multiple-cursors
nmap <C-n> <Plug>NextWholeOccurrence
xmap <C-n> <Plug>NextWholeOccurrence
nmap g<C-n> <Plug>NextOccurrence
xmap g<C-n> <Plug>NextOccurrence
nmap <C-p> <Plug>RemoveOccurrence
xmap <C-p> <Plug>RemoveOccurrence
